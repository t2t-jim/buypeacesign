# BuyPeaceSign PWA — environment variables
# Copy to .env.local for local dev. Set the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real secrets.

# --- Durable waitlist storage (required for POST /api/waitlist success) ---
# Prefer Vercel KV / Upstash integration names (Hobby):
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Or native Upstash Redis REST names (either pair works):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Resend email notify (recommended; signup still succeeds if missing/fails after persist) ---
RESEND_API_KEY=
# Default: searchjim@gmail.com
WAITLIST_NOTIFY_TO=searchjim@gmail.com
# Default uses Resend onboarding sender until you verify a domain:
RESEND_FROM=BuyPeaceSign <onboarding@resend.dev>
